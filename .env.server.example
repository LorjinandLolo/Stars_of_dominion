# Copy to .env on the server (next to compose.prod.yaml) and fill in.
# Never commit the filled-in .env.

# --- PostgreSQL ---
POSTGRES_USER=stars
POSTGRES_DB=stars_dominion
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME

# --- better-auth ---
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME
# The URL players use in their browser. LAN example:
BETTER_AUTH_URL=http://192.168.2.50:3000

# --- AI / LLM ---
# Options: ollama | gemini | template | mock. 'template' needs no API key.
LLM_PROVIDER=template
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Game ---
GAZETTE_WINDOW_DAYS=2

# --- Narrator (docs/narrative-system) ---
# Which writer produces gazette prose: template | ollama | gemini.
# 'template' needs nothing and always works; the others fall back to it on any
# failure, so this can degrade the writing but never stop the paper.
NARRATOR_LLM=template
# Only stories at or above this importance are worth a model call.
NARRATOR_LLM_MIN_IMPORTANCE=40
NARRATOR_LLM_MAX_PER_HOUR=40
NARRATOR_LLM_MAX_PER_DAY=300
# For NARRATOR_LLM=ollama. Point at the host running the daemon; a 4-8B model
# fits alongside Postgres and Next on a 16 GB machine.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_TIMEOUT_MS=120000
