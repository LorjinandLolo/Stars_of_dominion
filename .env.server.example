# Copy to .env on the server (next to compose.prod.yaml) and fill in:
#   cp .env.server.example .env && nano .env
# Never commit the filled-in .env.
#
# FOUR SETTINGS ARE REQUIRED — the stack will not start without them, and says
# which one is missing:
#   POSTGRES_PASSWORD, BETTER_AUTH_SECRET, BETTER_AUTH_URL, GAME_ADMIN_SECRET
# Everything else has a working default.

# ===== Required =====

# Database password. Read by Postgres only when its data volume is first
# created — changing it later does not change the database's password.
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME

# Signs every login session. Anyone who knows it can forge one.
# Generate: openssl rand -hex 32   (at least 32 characters)
BETTER_AUTH_SECRET=CHANGE_ME

# The PRIMARY address players type in their browser, scheme and port included.
# LAN: http://<server-ip>:3000   Public/tunnel: https://starsofdominion.com
BETTER_AUTH_URL=http://192.168.2.3:3000

# How the host frees a faction seat: POST /api/lobby/admin/reset (SERVER.md 6.3).
# Generate: openssl rand -hex 16
GAME_ADMIN_SECRET=CHANGE_ME

# ===== Optional =====

# Database user and name (defaults shown).
POSTGRES_USER=stars
POSTGRES_DB=stars_dominion

# Every OTHER origin the game is reachable on, comma-separated — better-auth
# 403s sign-ins from any origin not listed here or in BETTER_AUTH_URL. If you
# serve the LAN IP AND a tunnel domain, list whichever is not the primary:
# TRUSTED_ORIGINS=http://192.168.2.3:3000,https://starsofdominion.com
TRUSTED_ORIGINS=

# true = new accounts need a live invite code from a player (SERVER.md 6.3).
# Turn it on after the first player has claimed an empire.
INVITE_REQUIRED=

# Dev accounts DEV 1 / DEV 2 (Aurelian and Vektori pre-claimed). Created only
# on the FIRST start, only into an empty database, and only when this is set.
# Leave it empty on a server friends play on — it takes two of the fourteen
# empires. Useful for a test machine.
DEV_DUEL_PASSWORD=

# --- AI factions ---
# Options: ollama | gemini | template | mock. 'template' needs no API key.
LLM_PROVIDER=template
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Game ---
GAZETTE_WINDOW_DAYS=2

# --- Narrator (docs/narrative-system) ---
# Which writer produces gazette prose: template | ollama | gemini.
# 'template' needs nothing and always works; the others fall back to it on any
# failure, so this can degrade the writing but never stop the paper.
NARRATOR_LLM=template
# Only stories at or above this importance are worth a model call.
NARRATOR_LLM_MIN_IMPORTANCE=40
NARRATOR_LLM_MAX_PER_HOUR=40
NARRATOR_LLM_MAX_PER_DAY=300
# For NARRATOR_LLM=ollama. Point at the host running the daemon; a 4-8B model
# fits alongside Postgres and Next on a 16 GB machine.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_TIMEOUT_MS=120000
